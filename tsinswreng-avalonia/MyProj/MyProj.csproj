<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TrimMode Condition="'$(Configuration)' != 'Debug'">copyused</TrimMode>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<!-- Avalonia 的遙測目標會寫 %LOCALAPPDATA%\AvaloniaUI\BuildServices\buildtasks.log；
			 不可寫時 build 會以 MSB4018 失敗。清空本屬性即不執行該目標。 -->
		<UsedAvaloniaProducts></UsedAvaloniaProducts>
		<!-- 全域別名 str／obj／nil 全小寫是刻意的（與本規範各項目一致），
			 故關掉「型別名稱僅含小寫 ASCII 字元」的提醒。 -->
		<NoWarn>$(NoWarn);CS8981</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<PublishAot>true</PublishAot>
	</PropertyGroup>
	<ItemGroup>
		<None Remove=".gitignore" />
	</ItemGroup>
	<ItemGroup>
		<TrimmableAssembly Include="Avalonia.Themes.Fluent" />
		<TrimmableAssembly Include="Avalonia.Themes.Default" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Markup.Declarative" Version="12.1.1" />
		<!-- 官方生成器以 Roslyn 5.3 構建，而 SDK band 10.0.1xx 的編譯器是 5.0：
			 不補這個補丁包會得到 CS9057（分析器無法載入）外加十幾條
			 CS1061／CS1955（所有鏈式方法都找不到）。 -->
		<PackageReference Include="MarkupDeclarative.Roslyn4" Version="12.1.0" PrivateAssets="all" />
		<!-- 提供 [Doc] 這個註解用的 Attr（見 tsinswreng-csharp-doc-attr 規範）。 -->
		<PackageReference Include="Tsinswreng.CsCore" Version="0.0.1-alpha" />
		<!-- 只借它的轉值器 IValConvtrWithErr 與 FnConvtr；
			 它的 .A()、SetContent()、Ctx.Bind() 那一套不屬於本規範，不要用。 -->
		<PackageReference Include="Tsinswreng.Avln.Dsl" Version="0.3.0-alpha" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- 佈局容器 StackGrid。實作在本工作區的 Tsinswreng.Avln.Grid，各處共用一份。 -->
		<ProjectReference Include="..\..\..\..\..\Tsinswreng.Avln.Grid\proj\Tsinswreng.Avln.Grid\Tsinswreng.Avln.Grid.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System" />
		<Using Include="Avalonia" />
		<Using Include="Avalonia.Controls" />
		<Using Include="Avalonia.Controls.ApplicationLifetimes" />
		<Using Include="Avalonia.Data" />
		<Using Include="Avalonia.Interactivity" />
		<Using Include="Avalonia.Layout" />
		<Using Include="Avalonia.Markup.Declarative" />
		<Using Include="Avalonia.Media" />
		<Using Include="Avalonia.Themes.Fluent" />
	</ItemGroup>
</Project>